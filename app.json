{
  "expo": {
    "name": "DocOrg",
    "slug": "docorg",
    "scheme": "docorg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docorg.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DocOrg uses the camera to capture your documents. Photos stay on your device.",
        "NSPhotoLibraryUsageDescription": "DocOrg can read existing photos to add them to your library.",
        "NSPhotoLibraryAddUsageDescription": "DocOrg can save shared exports to your Photos library."
      }
    },
    "android": {
      "package": "com.docorg.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DocOrg to access your camera so you can photograph documents."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow DocOrg to access your camera so you can scan documents."
        }
      ],
      "expo-status-bar"
    ]
  }
}
